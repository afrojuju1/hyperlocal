# OpenAI (only needed if HYPERLOCAL_IMAGE_PROVIDER=openai)
OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=http://localhost:8000/v1

# LLM provider (remote NucBox Ollama, OpenAI-compatible)
HYPERLOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://100.111.132.114:11434/v1
OLLAMA_API_KEY=ollama
HYPERLOCAL_TEXT_MODEL=qwen3:8b

# Image generation (remote NucBox ComfyUI/Z-Image Turbo)
HYPERLOCAL_IMAGE_PROVIDER=comfyui_bg
COMFYUI_API_URL=http://100.111.132.114:8188
COMFYUI_WORKFLOW_PATH=config/comfyui_workflows/z_image_turbo_background.json
COMFYUI_TIMEOUT=600
COMFYUI_OUTPUT_NODE=10

# Database
# DATABASE_URL=postgresql+psycopg://hyperlocal:hyperlocal@localhost:55432/hyperlocal
# HYPERLOCAL_CREATIVE_RUN_POLL_INTERVAL=2
# HYPERLOCAL_CREATIVE_RUN_MAX_CONCURRENT=1

# Optional overrides
# HYPERLOCAL_IMAGE_SIZE=1024x1536
# HYPERLOCAL_IMAGE_QUALITY=high
# HYPERLOCAL_QC_ENABLED=0
# HYPERLOCAL_VARIANTS=1
# HYPERLOCAL_PERSIST_ENABLED=0
# TYPST_BIN=typst
